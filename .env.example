# ─── WebGit 環境變數設定 ──────────────────────────────────────────

# 服務埠號（預設 3000）
# PORT=3000

# 要瀏覽的 Git 儲存庫路徑（預設為當前目錄）
# REPO_PATH=/path/to/your/repo

# OpenAI 相容 API 路徑 — 用於 AI commit message 產生
# 預設使用 opencode.ai，可換成其他 OpenAI 相容服務
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# OpenAI 相容 API Key — 需向對應服務商申請金鑰
OPENCODE_API_KEY=sk-H3dtKaszWtNAJb8HJHO1K1ide2dJFZOM5c8IqFGtNn2sKcxlOc8T3DUQfriOl2Wq
