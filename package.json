{
  "name": "@rodriguezst_/webgit",
  "version": "1.0.4",
  "description": "A standalone Git viewer web client - browse your git repositories from the browser",
  "main": "src/server.js",
  "type": "module",
  "bin": {
    "webgit": "./bin/webgit.js"
  },
  "files": [
    "bin",
    "src",
    "public"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "css:build": "postcss public/css/src/style.css -o public/css/style.css",
    "css:watch": "postcss public/css/src/style.css -o public/css/style.css --watch",
    "deploy": "bash scripts/deploy.sh",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "keywords": [
    "git",
    "web",
    "viewer",
    "client",
    "cli",
    "repository",
    "browser"
  ],
  "author": "rodriguezst <git@rodriguezst.es>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodriguezst/webgit.git"
  },
  "homepage": "https://github.com/rodriguezst/webgit#readme",
  "bugs": {
    "url": "https://github.com/rodriguezst/webgit/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.18.2",
    "openai": "^7.1.0",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "cssnano": "^8.0.2",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
